# -------------------------------------------------------------------
# Ejemplo de configuración de la firma release (SIN valores reales)
# -------------------------------------------------------------------
# 1. Copiá este archivo como "keystore.properties" en la raíz del proyecto.
#    keystore.properties está en .gitignore: nunca se sube al repositorio.
# 2. Completá los valores con los de tu clave (creada con Android Studio:
#    Build > Generate Signed App Bundle or APK > Create new...).
# 3. Guardá el archivo .jks FUERA del proyecto.
#
# En storeFile usá barras "/" (en un .properties la barra invertida "\"
# es un carácter de escape).
#
# Sin este archivo, las variantes debug compilan normalmente y las
# release fallan con un mensaje que indica qué falta.

storeFile=C:/ruta/fuera/del/proyecto/mi-clave-release.jks
storePassword=COMPLETAR
keyAlias=COMPLETAR
keyPassword=COMPLETAR
