# -------------------------------------------------------------------
# Ejemplo de configuración del servicio remoto (NO contiene secretos)
# -------------------------------------------------------------------
# La app lee la URL base desde local.properties (raíz del proyecto),
# que no se sube al repositorio. Para usar un servidor propio, copiá
# la línea API_BASE_URL a tu local.properties y reemplazá el valor.
#
# - Debe terminar en "/" (si no, el build la agrega).
# - El servidor debe exponer:
#     GET    {API_BASE_URL}recordatorios
#     PUT    {API_BASE_URL}recordatorios/{id}   (crear o actualizar, idempotente)
#     DELETE {API_BASE_URL}recordatorios/{id}
#
# Si la clave NO existe (o queda vacía), se usa la URL de ejemplo
#   https://api.recordatorios.example/
# y la app funciona con el SERVIDOR SIMULADO integrado (no requiere
# ningún backend externo).
#
# No agregues tokens, contraseñas ni credenciales en este archivo
# ni en el código fuente.

API_BASE_URL=https://mi-servidor.ejemplo.com/api/
