<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 o inferior. Con allowBackup="false" no se hace copia de seguridad; estas
    exclusiones quedan como segunda barrera si alguna vez se reactiva el backup:
    nunca se copian la base de Room ni la sesión de Firebase.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
